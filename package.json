{
  "name": "cv-data-analysis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Analysis dashboards for data exported from Concrete Vision",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:data && npm run test:render",
    "test:data": "node scripts/smoke-test.mjs",
    "test:render": "vite build --ssr scripts/render-test.jsx --outDir .render-test --logLevel warn && node .render-test/render-test.js",
    "sample": "node scripts/make-sample.mjs > samples/employee-time.sample.csv"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
